# --- Database ---------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data/pglite (no setup needed).
# Set a PostgreSQL connection string for staging/production.
DATABASE_URL=
# TLS for remote PostgreSQL: "encrypt" (default; encrypted, certificate not verified — works with
# Supabase/Neon out of the box) or "verify" (full certificate verification).
DATABASE_SSL=encrypt

# One-time setup page (/setup) for a fresh production database: set a long random value, run the
# setup once, then remove the variable. Generate with: openssl rand -hex 24
SETUP_TOKEN=

# --- Sessions ---------------------------------------------------------------
# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL, used to build survey and invitation links.
APP_URL=http://localhost:3000

# --- AI provider ------------------------------------------------------------
# mock               deterministic provider, no network (default)
# openai_compatible  any OpenAI-compatible chat completions endpoint (Groq, Cloudflare Workers AI, gateways)
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Seed -------------------------------------------------------------------
# Password given to every seeded demo user (dev only).
SEED_PASSWORD=ngg-demo-2026
